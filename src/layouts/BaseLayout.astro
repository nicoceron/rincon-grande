---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/regent.css';
import '../styles/routes.css';

interface Props {
  title?: string;
  description?: string;
  pageScope?: string;
  bodyClass?: string;
}

const {
  title = 'Rincón Grande · Limay',
  description = 'Rincón Grande: lodge, Limay River, and authentic Patagonian experiences.',
  pageScope = Astro.url.pathname,
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-page-scope={pageScope}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf9ef" />
    <link rel="icon" type="image/png" href="/assets/rincon/logo-verde.png" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <SiteHeader />
    <main>
      <slot name="before-main" />
      <div class="main-wrap" data-framer-name="Main Wrap">
        <slot />
        <SiteFooter />
      </div>
    </main>
    <a class="source-framer-badge" data-framer-name="Light" href="https://www.framer.com" rel="noopener" aria-hidden="true" tabindex="-1">
      <span data-framer-name="Backdrop" aria-hidden="true"></span>
      <span data-framer-name="Content" aria-hidden="true">
        <span data-framer-name="Logo" aria-hidden="true"></span>
        <span data-framer-name="Text" aria-hidden="true"></span>
      </span>
      <span data-framer-name="Bottom" aria-hidden="true"></span>
      <span data-framer-name="Border" aria-hidden="true"></span>
      <span class="source-framer-badge-text">Create a free website with Framer, the website builder loved by startups, designers and agencies.</span>
    </a>
    <script>
      import '../scripts/regent-behavior.js';
    </script>
  </body>
</html>
