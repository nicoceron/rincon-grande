---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceRouteButton from '../components/SourceRouteButton.astro';
---

<BaseLayout pageScope="/404" bodyClass="route-page route-page--error">
  <section class="source-error-page" aria-labelledby="route-error-title">
    <div class="source-error-media" aria-hidden="true">
      <img src="/assets/rincon/landscape-peak.webp" alt="Patagonian landscape" style="width:100%;height:100%;object-fit:cover" />
    </div>

    <div class="source-error-content">
      <h1 id="route-error-title"><span>404</span></h1>
      <div class="source-error-copy">
        <p class="source-error-label">Page Not Found</p>
        <p class="source-error-message">The page you are looking for was not found or relocated.</p>
        <SourceRouteButton href="/" label="Go to Homepage" />
      </div>
    </div>
  </section>
</BaseLayout>
