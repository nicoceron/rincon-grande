---
import SectionHeading from './SectionHeading.astro';
import SectionLink from './SectionLink.astro';
---

<section class="rooms-section framer-vxebwx" id="rooms" aria-labelledby="rooms-title" data-framer-name="Our Rooms">
  <div class="rooms-container framer-15j917m" data-framer-name="Container">
    <div class="rooms-content-wrap framer-1w48kip reveal" data-reveal data-framer-name="Content Wrap">
      <div class="rooms-copy rooms-text-column framer-ky76i8" data-framer-name="Wrap">
        <div class="rooms-heading-wrap framer-b379jf" data-framer-name="Heading">
          <SectionHeading bare eyebrow="The Lodge" title="Cypress, stone, and life beside the river" id="rooms-title" class="rooms-heading" />
        </div>
        <div class="rooms-text-wrap framer-lwhx5n" data-framer-name="Text Wrap">
          <div class="rich-text-block" data-framer-component-type="RichTextContainer">
            <p>Three en-suite suites and an additional bedroom accommodate up to eight guests. The glass-walled living room, wood-burning fireplace, and river form the heart of the stay.</p>
          </div>
        </div>
        <div class="rooms-link-wrap framer-1vvly9q-container">
          <div class="rooms-link-variant">
            <SectionLink href="/rooms" mobileHref="./rooms" label="Explore the lodge" />
          </div>
        </div>
      </div>

      <div class="rooms-collage rooms-image-column framer-ut659k" data-framer-name="Wrap" aria-hidden="true">
        <div class="rooms-image-slot rooms-image-slot-small framer-ay6zz8" data-framer-name="Image Wrapper">
          <div class="rooms-image-variant">
            <div class="rooms-image-media" data-framer-name="Image">
              <div class="rooms-background-wrapper" data-framer-background-image-wrapper="true">
                <img class="rooms-image rooms-image-small" src="/assets/rincon/lodge-fireplace.webp" alt="Lodge fireplace" loading="lazy" />
              </div>
            </div>
          </div>
        </div>
        <div class="rooms-image-slot rooms-image-slot-large framer-1dod0ki" data-framer-name="Image Wrapper">
          <div class="rooms-image-variant">
            <div class="rooms-image-media" data-framer-name="Image">
              <div class="rooms-background-wrapper" data-framer-background-image-wrapper="true">
                <img class="rooms-image rooms-image-large" src="/assets/rincon/lodge-living.webp" alt="Glass-walled lodge living room overlooking the landscape" loading="lazy" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
