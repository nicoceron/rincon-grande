---
import InlineSvg from './InlineSvg.astro';
---

<section class="hero-section framer-1ysu942" id="hero-section" aria-labelledby="hero-title" data-framer-name="Hero Section">
  <div class="hero-container framer-1uo4q2k" data-framer-name="Container">
    <div class="hero-content framer-1r7y3q3" data-framer-name="Content">
      <div class="hero-top hero-center framer-gcmf8g" data-framer-name="Top">
        <div class="hero-headline-wrap framer-1chkusm" data-framer-name="Headline Wrap">
          <InlineSvg kind="wordmark-large" class="hero-wordmark" id="hero-title" label="The Regent" />
        </div>
        <div class="hero-estate-wrap hero-estate-mark framer-qo0z5p" data-framer-name="Wrap" aria-label="Established 1928">
          <div class="hero-estate-label" data-framer-component-type="RichTextContainer"><p>Est</p></div>
          <div class="hero-estate-crest" data-framer-name="SVG" data-framer-component-type="SVG">
            <div class="hero-svg-container"><InlineSvg kind="crest" class="hero-crest" /></div>
          </div>
          <div class="hero-estate-year" data-framer-name="1972" data-framer-component-type="RichTextContainer"><p>1928</p></div>
        </div>
      </div>

      <div class="hero-bottom framer-ps6yrn" data-framer-name="Bottom">
        <div class="hero-bottom-wrap framer-r8ldrt" data-framer-name="Wrap">
          <div class="hero-bottom-text framer-8tdca5" data-framer-name="Text Wrapper">
            <div class="hero-rich-text" data-framer-component-type="RichTextContainer">
              <p class="eyebrow">Welcome to The Regent</p>
            </div>
            <div class="hero-tagline-wrap" data-framer-name="Text Wrapper">
              <div class="hero-rich-text" data-framer-component-type="RichTextContainer">
                <p class="hero-tagline">Discover Unparalleled Luxury at Lake Tahoe's Premier Boutique Retreat</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-image-wrapper framer-2udir8" data-framer-name="Image Wrapper">
    <div class="hero-video-container framer-1vgtwi9-container">
      <video
        class="hero-video"
        src="/assets/media/jXevRX7EQwFseJ7djNws4zu1daM.mp4"
        poster="/assets/media/ye5iOdi8OTDZhwGrQSZ0kuUDI.webp"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
      <div class="hero-shade" aria-hidden="true"></div>
    </div>
  </div>
</section>
