---
import WordSpans from './WordSpans.astro';
---

<section class="categories-section framer-7bl2mc" id="categories" aria-labelledby="categories-title" data-framer-name="Categories">
  <div class="categories-container framer-qc7cm1" data-framer-name="Container">
    <div class="categories-heading framer-cfgki0" data-framer-name="Heading">
      <div class="category-rich-text" data-framer-component-type="RichTextContainer">
        <p class="eyebrow">Experiences</p>
      </div>
      <div class="category-rich-text" data-framer-component-type="RichTextContainer">
        <h2 id="categories-title"><WordSpans text="Six ways to experience the landscape" /></h2>
      </div>
    </div>

    <div class="category-grid categories-content-wrap framer-171c88u reveal" data-reveal data-reveal-threshold="0.4" data-framer-name="Content Wrap">
      <div class="category-card-wrapper category-card-wide framer-nh5ktt" data-framer-name="Image Wrapper">
        <div class="category-variant-shell">
          <div class="category-card-container">
            <a class="category-card" href="/wellness" data-desktop-href="/wellness" data-mobile-href="./wellness" data-astro-href="/wellness" data-framer-name="Desktop - Video">
          <div class="category-image-wrap" data-framer-name="Image Wrap">
            <div class="category-media-container" data-image-transition="true" data-transition-interval="5000">
              <div class="category-background-wrapper" data-framer-background-image-wrapper="true">
                <img class="image-transition-layer is-active" src="/assets/rincon/optimized/angler-wide.webp" alt="Fly fisherman on the Limay River" loading="lazy" />
                <img class="image-transition-layer" src="/assets/rincon/optimized/angler-detail.webp" alt="" loading="lazy" aria-hidden="true" />
                <img class="image-transition-layer" src="/assets/rincon/optimized/fishing-guide.webp" alt="" loading="lazy" aria-hidden="true" />
              </div>
            </div>
          </div>
          <div class="category-content-wrap" data-framer-name="Wrap">
            <div class="category-text-wrap" data-framer-name="Text Wrap">
              <div class="category-title-wrap" data-framer-name="Our Story" data-framer-component-type="RichTextContainer">
                <h2><WordSpans text="Fishing" /></h2>
              </div>
            </div>
          </div>
            </a>
          </div>
        </div>
      </div>
      <div class="category-card-wrapper category-card-second framer-4ttjpy" data-framer-name="Wrap">
        <div class="category-card-variant framer-g6bo8w-container">
          <div class="category-variant-shell">
            <a class="category-card" href="/experiences/winter" data-desktop-href="/experiences/winter" data-mobile-href="./experiences/winter" data-astro-href="/experiences/winter" data-framer-name="Desktop">
            <div class="category-image-wrap" data-framer-name="Image Wrap">
              <div class="category-media-container">
                <div class="category-background-wrapper" data-framer-background-image-wrapper="true">
                  <img src="/assets/rincon/optimized/hunting-wide.webp" alt="Hunters in the Patagonian steppe" loading="lazy" />
                </div>
              </div>
            </div>
            <div class="category-content-wrap" data-framer-name="Wrap">
              <div class="category-text-wrap" data-framer-name="Text Wrap">
                <div class="category-title-wrap" data-framer-name="Our Story" data-framer-component-type="RichTextContainer">
                  <h2><WordSpans text="Hunting" /></h2>
                </div>
              </div>
            </div>
            </a>
          </div>
        </div>
        <div class="category-card-variant framer-y4zst6-container">
          <div class="category-variant-shell">
            <a class="category-card" href="/dining" data-desktop-href="/dining" data-mobile-href="./dining" data-astro-href="/dining" data-framer-name="Desktop">
            <div class="category-image-wrap" data-framer-name="Image Wrap">
              <div class="category-media-container">
                <div class="category-background-wrapper" data-framer-background-image-wrapper="true">
                <img src="/assets/rincon/optimized/riders-wide.webp" alt="Riders in the Patagonian landscape" loading="lazy" />
                </div>
              </div>
            </div>
            <div class="category-content-wrap" data-framer-name="Wrap">
              <div class="category-text-wrap" data-framer-name="Text Wrap">
                <div class="category-title-wrap" data-framer-name="Our Story" data-framer-component-type="RichTextContainer">
                  <h2><WordSpans text="Horseback Riding" /></h2>
                </div>
              </div>
            </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
