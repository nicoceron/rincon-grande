---
import SocialIcon from './SocialIcon.astro';

const isHome = Astro.url.pathname === '/';
const homeHref = '/';
const mobileHomeHref = isHome ? './' : '/';
const astroHrefFor = (href: string) => href.startsWith('./') ? href.slice(1) || '/' : undefined;
const mainLinks = [
  ['Home', homeHref, mobileHomeHref],
  ['About', '/about', './about'],
  ['Rooms', '/rooms', './rooms'],
  ['Dining', '/dining', './dining'],
  ['Wellness', '/wellness', './wellness'],
  ['Experiences', '/experiences/winter', './experiences/winter'],
];
---

<footer class="site-footer framer-4mycA" data-framer-name="Desktop">
  <div class="footer-container framer-e6n9q4" data-framer-name="Container">
    <div class="footer-content-wrapper framer-13pzdmi" data-framer-name="Content Wrapper">
      <div class="footer-row footer-primary-row framer-15sqh4o" data-framer-name="Row">
        <div class="footer-wrap footer-logo-wrap framer-1w0txqv" data-framer-name="Wrap">
          <a
            class="footer-logo framer-ms5rqh"
            href={homeHref}
            data-desktop-href={homeHref}
            data-mobile-href={mobileHomeHref}
            data-astro-href="/"
            aria-label="The Regent home"
            data-framer-name="Footer Logo"
          >
            <div class="footer-logo-mark" data-framer-component-type="SVG" aria-hidden="true"></div>
          </a>
          <div class="footer-columns" data-framer-name="Wrap">
            <div class="footer-column footer-book framer-1pmrm2t" data-framer-name="Item">
              <div class="footer-heading" data-framer-name="Text" data-framer-component-type="RichTextContainer">
                <p class="eyebrow">Book your stay</p>
              </div>
              <div class="footer-copy-wrap" data-framer-name="Wrap">
                <div class="footer-rich-text" data-framer-component-type="RichTextContainer">
                  <p class="footer-large-copy">Experience timeless luxury in every season.</p>
                </div>
              </div>
              <div class="footer-book-button-container">
                <a class="footer-book-button button-fill" href="https://booking.com" target="_blank" rel="noopener" data-framer-name="Desktop">
                  <div class="footer-button-wrapper" data-framer-name="Button Wrapper">
                    <div class="footer-rich-text" data-framer-name="Text" data-framer-component-type="RichTextContainer">
                      <p>Book Now</p>
                    </div>
                    <div class="footer-button-fill" data-framer-name="Button Fill" aria-hidden="true"></div>
                  </div>
                </a>
              </div>
            </div>

            <div class="footer-column footer-address framer-hkz9vk" data-framer-name="Item">
              <div class="footer-heading" data-framer-name="Text" data-framer-component-type="RichTextContainer">
                <p class="eyebrow">Address</p>
              </div>
              <div class="footer-address-copy" data-framer-component-type="RichTextContainer">
                <p>2847 Lakeshore Boulevard South Lake Tahoe, CA 96150</p>
              </div>
            </div>

            <div class="footer-column footer-main-links framer-koz2tu" data-framer-name="Item">
              <div class="footer-heading" data-framer-name="Text" data-framer-component-type="RichTextContainer">
                <p class="eyebrow">Main</p>
              </div>
              <div class="footer-link-list" data-footer-link-list data-framer-name="Wrap">
                {mainLinks.map(([label, desktopHref, mobileHref]) => (
                  <div class="footer-link-wrap" data-framer-name="Wrap">
                    <div class="footer-link-container">
                      <a href={desktopHref} data-desktop-href={desktopHref} data-mobile-href={mobileHref} data-astro-href={astroHrefFor(mobileHref)} data-framer-name="Dark">
                        <div class="footer-link-underline" data-framer-name="Underline" aria-hidden="true"></div>
                        <div class="footer-rich-text" data-framer-component-type="RichTextContainer">
                          <p>{label}</p>
                        </div>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="footer-column footer-support framer-bydnic" data-framer-name="Item">
              <div class="footer-heading" data-framer-name="Text" data-framer-component-type="RichTextContainer">
                <p class="eyebrow">Support</p>
              </div>
              <div class="footer-link-list">
                <div class="footer-link-container">
                  <a href="/404" data-desktop-href="/404" data-mobile-href="./404" data-astro-href="/404" data-framer-name="Dark">
                    <div class="footer-link-underline" data-framer-name="Underline" aria-hidden="true"></div>
                    <div class="footer-rich-text" data-framer-component-type="RichTextContainer"><p>404</p></div>
                  </a>
                </div>
                <div class="footer-link-container">
                  <a href="/contact" data-desktop-href="/contact" data-mobile-href="./contact" data-astro-href="/contact" data-framer-name="Dark">
                    <div class="footer-link-underline" data-framer-name="Underline" aria-hidden="true"></div>
                    <div class="footer-rich-text" data-framer-component-type="RichTextContainer"><p>Contact Us</p></div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="footer-row footer-legal framer-17nf9rc" data-framer-name="Row">
        <div class="social-links footer-social-link-wrap framer-1aaapl2" aria-label="Social links" data-framer-name="Social Link Wrap">
          <div class="footer-social-container">
            <a tabindex="0" aria-label="LinkedIn" data-framer-name="Desktop - Default"><SocialIcon name="linkedin" /></a>
          </div>
          <div class="footer-social-container">
            <a tabindex="0" aria-label="Instagram" data-framer-name="Desktop - Default"><SocialIcon name="instagram" /></a>
          </div>
          <div class="footer-social-container">
            <a tabindex="0" aria-label="YouTube" data-framer-name="Desktop - Default"><SocialIcon name="youtube" /></a>
          </div>
        </div>
        <div class="footer-rich-text" data-framer-component-type="RichTextContainer">
          <p class="coordinates">46.6863° N, 8.1728° E</p>
        </div>
        <div class="legal-line" data-framer-name="Legal">
          <div class="footer-rich-text" data-framer-component-type="RichTextContainer">
            <p class="copyright">©2025. All right reserved</p>
          </div>
          <div class="legal-separator" data-framer-component-type="SVG" data-framer-name="Line" aria-hidden="true">
            <div class="svg-container">
              <svg viewBox="0 0 1 22" aria-hidden="true" focusable="false"><path d="M.5 0v22" stroke="currentColor" /></svg>
            </div>
          </div>
          <div class="footer-rich-text" data-framer-component-type="RichTextContainer">
            <p><a class="credit" href="https://flowit.supply" target="_blank" rel="noopener">By Flowit Suppy</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>

</footer>
