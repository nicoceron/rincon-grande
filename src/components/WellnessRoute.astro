---
import SourceRouteButton from './SourceRouteButton.astro';
import SourceRouteHero from './SourceRouteHero.astro';
import RouteMedia from './RouteMedia.astro';
import WordSpans from './WordSpans.astro';
import type { RoutePageData } from '../data/route-pages';

interface Props {
  page: RoutePageData;
}

const { page } = Astro.props;
const overview = page.sections.find((section) => section.id === 'wellness');
const spa = page.sections.find((section) => section.id === 'spa');
const heat = page.sections.find((section) => section.id === 'heat-therapy');
const fitness = page.sections.find((section) => section.id === 'fitness');
---

<SourceRouteHero page={page} />

<section class="source-wellness-overview" aria-labelledby="wellness-overview-title">
  <div class="source-wellness-overview-inner">
    <div>
      <p class="eyebrow">{overview?.eyebrow}</p>
      <h2 id="wellness-overview-title" class="reveal" data-reveal><WordSpans text={overview?.title ?? ''} /></h2>
    </div>
    <div class="source-wellness-overview-copy">
      {overview?.body?.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<section class="source-wellness-spa" aria-labelledby="wellness-spa-title">
  <div class="source-wellness-spa-pool">
    <RouteMedia src="/assets/rincon/optimized/angler-vertical.webp" type="image" alt="Fly fisherman standing in the Limay River" loading="lazy" />
  </div>
  <div class="source-wellness-spa-treatment">
    <RouteMedia src="/assets/rincon/optimized/hero-limay.webp" type="image" alt="The Limay River beside the estate" loading="lazy" />
  </div>
  <div class="source-wellness-spa-copy">
    <h3 id="wellness-spa-title" class="reveal" data-reveal><WordSpans text={spa?.eyebrow ?? ''} /></h3>
    <p>{spa?.body?.[0]}</p>
  </div>
</section>

<section class="source-wellness-heat" aria-labelledby="wellness-heat-title">
  <div class="source-wellness-heat-inner">
    <h2 id="wellness-heat-title" class="reveal" data-reveal><WordSpans text={heat?.eyebrow ?? ''} /></h2>
    <div class="source-wellness-heat-left">
      <RouteMedia src="/assets/rincon/optimized/angler-detail.webp" type="image" alt="Fly-fishing detail on the Limay" loading="lazy" />
    </div>
    <div class="source-wellness-heat-copy">
      {heat?.body?.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="source-wellness-heat-right">
      <RouteMedia src="/assets/rincon/optimized/landscape-limay.webp" type="image" alt="Open landscape along the Limay River" loading="lazy" />
    </div>
  </div>
</section>

<section class="source-wellness-fitness" aria-labelledby="wellness-fitness-title">
  <div class="source-wellness-fitness-media">
    <RouteMedia src="/assets/rincon/optimized/fishing-guide.webp" type="image" alt="Fishing guide beside the river" loading="lazy" />
  </div>
  <div class="source-wellness-fitness-copy">
    <h2 id="wellness-fitness-title" class="reveal" data-reveal><WordSpans text={fitness?.title ?? ''} /></h2>
    {fitness?.body?.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<section class="source-wellness-cta" aria-labelledby="wellness-cta-title">
  <div>
    <p class="eyebrow">{page.cta?.eyebrow}</p>
    <h3 id="wellness-cta-title" class="reveal" data-reveal><WordSpans text={page.cta?.title ?? ''} /></h3>
    {page.cta && <SourceRouteButton href={page.cta.href} label={page.cta.label} />}
  </div>
</section>
