---
import rinconWordmarkSource from '../assets/inline-svg/rincon-wordmark-source.svg?raw';
import rinconFooterLogo from '../assets/inline-svg/rincon-footer-logo-source.svg?raw';
import rinconSymbol from '../assets/inline-svg/rincon-symbol.svg?raw';
import asSeen1 from '../assets/inline-svg/as-seen-1.svg?raw';
import asSeen2 from '../assets/inline-svg/as-seen-2.svg?raw';
import asSeen3 from '../assets/inline-svg/as-seen-3.svg?raw';
import asSeen4 from '../assets/inline-svg/as-seen-4.svg?raw';

type SvgKind =
  | 'stamp'
  | 'wordmark-small'
  | 'wordmark-dark'
  | 'wordmark-large'
  | 'crest'
  | 'footer-logo'
  | `as-seen-${1 | 2 | 3 | 4}`;

const { kind, class: className = '', id = '', label = '' } = Astro.props as {
  kind: SvgKind;
  class?: string;
  id?: string;
  label?: string;
};
const sources: Record<SvgKind, string> = {
  'wordmark-small': rinconWordmarkSource,
  'wordmark-dark': rinconWordmarkSource,
  'wordmark-large': rinconWordmarkSource,
  stamp: rinconSymbol,
  crest: rinconSymbol,
  'footer-logo': rinconFooterLogo,
  'as-seen-1': asSeen1,
  'as-seen-2': asSeen2,
  'as-seen-3': asSeen3,
  'as-seen-4': asSeen4,
};
const source = sources[kind];
const attributes = [
  className ? `class="${className}"` : '',
  id ? `id="${id}"` : '',
  label ? `role="img" aria-label="${label}"` : '',
].filter(Boolean).join(' ');
const svg = attributes ? source.replace('<svg ', `<svg ${attributes} `) : source;
---

<Fragment set:html={svg} />
