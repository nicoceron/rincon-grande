---
import WordSpans from './WordSpans.astro';

const gallery = [
  'lodge-garden.webp',
  'hero-limay.webp',
  'angler-wide.webp',
  'hunting-wide.webp',
  'riders-wide.webp',
  'landscape-mountains.webp',
  'lodge-living.webp',
  'campfire.webp',
];

// Keep all eight images mounted so a drag can move every card continuously.
// The last item starts just outside the seven visible source positions.
const initialSlots = [0, 1, 2, 3, 5, 6, 7, 4];
---

<section class="gallery-section framer-d61eft" aria-labelledby="gallery-title" data-framer-name="Gallery" data-gallery-images={JSON.stringify(gallery)}>
  <div class="gallery-container framer-1bi9lf7" data-framer-name="Container">
    <div class="gallery-content-wrap framer-j34tqm reveal" data-reveal data-reveal-threshold="0.4" data-framer-name="Content Wrap">
      <div class="gallery-heading framer-7ino0d" data-framer-name="Heading">
        <div class="gallery-rich-text" data-framer-component-type="RichTextContainer">
        <p class="eyebrow">Gallery</p>
        </div>
        <div class="gallery-rich-text" data-framer-component-type="RichTextContainer">
          <h2 id="gallery-title"><WordSpans text="A glimpse of Rincón Grande" /></h2>
        </div>
      </div>
      <div class="gallery-window gallery-carousel framer-zc0zd4-container" data-gallery-window role="region" tabindex="0" aria-label="Rincón Grande gallery">
        <div class="gallery-stage">
          <div class="gallery-track">
            {initialSlots.map((imageIndex, slotIndex) => (
              <div class={`gallery-card gallery-card-${slotIndex + 1}`}>
                <img
                  class={`gallery-image gallery-image-${slotIndex + 1}`}
                  src={`/assets/rincon/${gallery[imageIndex]}`}
                  data-gallery-slot={slotIndex}
                  data-gallery-index={imageIndex}
                  alt=""
                  draggable="false"
                />
              </div>
            ))}
          </div>
          <button class="gallery-control gallery-control-prev" type="button" data-gallery-prev aria-label="Previous gallery image">
            <span aria-hidden="true">‹</span>
          </button>
          <button class="gallery-control gallery-control-next" type="button" data-gallery-next aria-label="Next gallery image">
            <span aria-hidden="true">›</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Keep the fixed cursor outside the revealed gallery subtree. A transformed
     ancestor would otherwise turn fixed positioning into section positioning. -->
<div class="gallery-drag-cursor" data-gallery-cursor aria-hidden="true">
  <div class="gallery-drag-cursor-shell">
    <svg viewBox="0 0 100 100" overflow="visible" focusable="false">
      <defs>
        <path id="gallery-drag-cursor-path" d="M 0 50 L 0 50 A 1 1 0 0 1 100 50 L 100 50 L 100 50 A 1 1 0 0 1 0 50 L 0 50" />
      </defs>
      <text>
      <textPath href="#gallery-drag-cursor-path" startOffset="7" dominant-baseline="hanging">DRAG - DRAG - DRAG - </textPath>
      </text>
    </svg>
    <span></span>
  </div>
</div>
