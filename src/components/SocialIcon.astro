---

<div class="social-icon-wrap" data-framer-name="Icon Wrap">
  <div class="social-icon-container social-icon-primary">
    <div class="social-icon-layer">
      <svg class="social-icon" viewBox="0 0 256 256" role="img" aria-label={labels[name]} focusable="false">
        <path d={paths[name]} fill="currentColor" />
      </svg>
    </div>
  </div>
  <div class="social-icon-container social-icon-secondary" aria-hidden="true">
    <div class="social-icon-layer">
      <svg class="social-icon" viewBox="0 0 256 256" focusable="false">
        <path d={paths[name]} fill="currentColor" />
      </svg>
    </div>
  </div>
</div>
