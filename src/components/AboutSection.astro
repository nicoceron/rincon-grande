---
import SectionLink from './SectionLink.astro';
import SectionHeading from './SectionHeading.astro';
import InlineSvg from './InlineSvg.astro';
---

<section class="about-section framer-1bb7ko8" aria-labelledby="about-title" data-framer-name="About">
  <div class="about-container framer-158rqsw" data-framer-name="Container">
    <div class="about-inner about-content-wrap framer-ifw2bz reveal" data-reveal data-framer-name="Content Wrap">
      <div class="about-heading framer-yrsh9i" data-framer-name="Heading">
        <SectionHeading eyebrow="About The Regent" title="A Legacy of Mountain Hospitality" as="h1" id="about-title" />
      </div>
      <div class="about-copy about-text-wrap framer-4lexi" data-framer-name="Wrap">
        <div class="about-text-content framer-1enthiq" data-framer-name="Text Content Wrap">
          <div class="about-text-block framer-1bynkr0" data-framer-name="Text Wrap">
            <div class="rich-text-block" data-framer-component-type="RichTextContainer">
              <p>Since 1928, The Regent has been Lake Tahoe's most distinguished boutique retreat. Our intimate collection of suites offers discerning travelers an exclusive sanctuary where timeless elegance meets modern luxury.</p>
            </div>
          </div>
          <div class="about-text-block framer-109k6qa" data-framer-name="Text Wrap">
            <div class="rich-text-block" data-framer-component-type="RichTextContainer">
              <p>From personalized concierge service to curated seasonal experiences, we honor nearly a century of tradition while embracing contemporary comfort. Whether seeking adventure or tranquility, discover an unforgettable escape defined by exceptional hospitality and breathtaking natural beauty.</p>
            </div>
          </div>
        </div>
        <div class="about-link-wrap framer-4g08ao-container">
          <SectionLink href="/about" mobileHref="./about" label="Learn More" />
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-image about-image framer-116m5gv" aria-hidden="true" data-framer-name="Section  Image">
  <div class="about-image-inner framer-e54b2n" data-framer-name="Image Content ">
    <div class="about-image-media" data-framer-name="Image Wrap">
      <div class="about-image-overlay" aria-hidden="true" data-framer-name="Overlay"></div>
      <div class="about-stamp-wrap" data-framer-name="Stamp Wrap">
        <InlineSvg kind="stamp" class="about-stamp" />
      </div>
      <img src="/assets/media/WNN0TqL1kayfzoDpYYHovVHpQE.webp" alt="" loading="lazy" />
    </div>
  </div>
</div>
